#!/usr/bin/env python3
"""
jarvis-tool-call-watcher — daemon en LXC 104.
Escanea sesiones JSONL recientes para detectar el patrón de fallo:
   "el modelo emite <tool_call>{...}</tool_call> pero NO ejecuta nada"
Esto pasa cuando Qwen3 cae en el modo tool-calling estilo OpenAI/MCP, que
en este sistema no se procesa: produce respuestas vacías sin verificación.

Heurística:
  - Sesión activa (modificada en últimos N min)
  - 2+ mensajes assistant consecutivos cuyo texto contiene `<tool_call>`
  - Sin tool_result ni mensaje real entre ellos
  -> Sesión corrupta. Borrar y avisar al usuario.

Frecuencia: cada 90 s, no overlap con cooldown.
"""
import json, os, re, time, urllib.request
from pathlib import Path
from datetime import datetime

SESSION_DIR = Path("/root/.openclaw/agents/main/sessions")
LOG_FILE    = Path("/var/log/jarvis-tool-call-watcher.log")
ENV_FILE    = Path("/root/.jarvis-sentinel.env")
STATE_FILE  = Path("/var/lib/jarvis/tool-call-watcher.state")

CHECK_EVERY = 90
ACTIVE_WINDOW_S = 1800        # solo sesiones modificadas en últimos 30 min
MIN_FAKE_TOOLCALLS = 2        # umbral para disparar repair
COOLDOWN_S = 600              # entre repairs

TOOLCALL_RE = re.compile(r"<tool_call>", re.I)

TG_BOT_TOKEN = None
TG_CHAT_ID   = None


def log(msg):
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line, flush=True)
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with LOG_FILE.open("a") as f:
            f.write(line + "\n")
    except Exception:
        pass


def load_env():
    global TG_BOT_TOKEN, TG_CHAT_ID
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if line.startswith("TG_BOT_TOKEN="):
                TG_BOT_TOKEN = line.split("=", 1)[1].strip()
            elif line.startswith("TG_CHAT_ID="):
                TG_CHAT_ID = line.split("=", 1)[1].strip()


def send_telegram(msg):
    if not TG_BOT_TOKEN or not TG_CHAT_ID:
        return
    payload = json.dumps({"chat_id": TG_CHAT_ID, "text": msg}).encode()
    try:
        req = urllib.request.Request(
            f"https://api.telegram.org/bot{TG_BOT_TOKEN}/sendMessage",
            data=payload, headers={"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=10)
    except Exception as e:
        log(f"[warn] Telegram: {e}")


def load_session(path):
    out = []
    try:
        with path.open() as f:
            for line in f:
                try:
                    out.append(json.loads(line))
                except Exception:
                    pass
    except Exception as e:
        log(f"[warn] no se pudo leer {path.name}: {e}")
    return out


def message_text(entry):
    """Extrae el texto de un entry tipo {message: {role, content}}."""
    msg = entry.get("message")
    if not isinstance(msg, dict):
        return None, None
    role = msg.get("role")
    content = msg.get("content", [])
    if isinstance(content, str):
        return role, content
    parts = []
    if isinstance(content, list):
        for c in content:
            if not isinstance(c, dict):
                continue
            t = c.get("type")
            if t == "text":
                parts.append(c.get("text", ""))
            elif t == "tool_result":
                # Marca para saber que hubo un tool result real
                parts.append("__TOOL_RESULT__")
    return role, "\n".join(parts)


def detect_fake_toolcalls(msgs):
    """Devuelve número de mensajes assistant consecutivos con <tool_call> sin tool_result entre ellos."""
    consec = 0
    max_consec = 0
    for entry in msgs:
        role, text = message_text(entry)
        if text is None:
            continue
        if role == "assistant" and text and TOOLCALL_RE.search(text):
            consec += 1
            max_consec = max(max_consec, consec)
        elif "__TOOL_RESULT__" in (text or ""):
            consec = 0
        elif role == "user":
            # mensaje de usuario interrumpe el racimo
            consec = 0
    return max_consec


def get_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except Exception:
        return {"last_repair": 0, "handled": {}}


def save_state(state):
    try:
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        STATE_FILE.write_text(json.dumps(state))
    except Exception as e:
        log(f"[warn] no se pudo guardar state: {e}")


def repair(session_path, fake_count):
    log(f"[repair] sesion={session_path.name} fake_toolcalls={fake_count}")
    try:
        session_path.unlink()
        log(f"[repair] sesion borrada: {session_path.name}")
    except Exception as e:
        log(f"[error] no se pudo borrar {session_path.name}: {e}")
        return False
    send_telegram(
        "Jarvis estaba dando respuestas falsas (tool calls no ejecutados). "
        "He limpiado la sesión. Reenvía tu última petición."
    )
    return True


def main():
    load_env()
    log("jarvis-tool-call-watcher arrancado")
    if not SESSION_DIR.exists():
        log(f"[fatal] no existe {SESSION_DIR}, abortando")
        return

    while True:
        now = time.time()
        state = get_state()
        try:
            for path in SESSION_DIR.glob("*.jsonl"):
                if "checkpoint" in path.name:
                    continue
                mtime = path.stat().st_mtime
                if now - mtime > ACTIVE_WINDOW_S:
                    continue  # sesión inactiva, no nos preocupa
                msgs = load_session(path)
                fake = detect_fake_toolcalls(msgs)
                if fake < MIN_FAKE_TOOLCALLS:
                    continue
                # No volver a actuar sobre la misma sesión durante el cooldown
                handled_at = state.get("handled", {}).get(path.name, 0)
                if now - handled_at < COOLDOWN_S:
                    continue
                if now - state.get("last_repair", 0) < COOLDOWN_S:
                    log(f"[skip] cooldown global activo (sesion={path.name})")
                    continue
                if repair(path, fake):
                    state.setdefault("handled", {})[path.name] = now
                    state["last_repair"] = now
                    save_state(state)
        except Exception as e:
            log(f"[error] loop: {e}")

        time.sleep(CHECK_EVERY)


if __name__ == "__main__":
    main()
